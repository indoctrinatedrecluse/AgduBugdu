<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AgduBugdu.App.ViewModels"
        xmlns:views="using:AgduBugdu.App.Views"
        xmlns:dock="using:Dock.Avalonia.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="AgduBugdu.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/agdubugdu-logo.ico"
        Title="{Binding AppTitle}"
        Width="1280" Height="760"
        Background="{Binding WindowBackground}"
        WindowStartupLocation="CenterScreen">

    <!-- Keyboard Hotkeys -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+P" Command="{Binding OpenCommandPaletteCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+P" Command="{Binding OpenCommandPaletteCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewFileCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenFileCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveFileCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveFileAsCommand}" />
        <KeyBinding Gesture="Ctrl+F" Command="{Binding OpenFindCommand}" />
        <KeyBinding Gesture="Ctrl+H" Command="{Binding OpenReplaceCommand}" />
        <KeyBinding Gesture="Ctrl+G" Command="{Binding OpenGoToLineCommand}" />
        <KeyBinding Gesture="Ctrl+M" Command="{Binding GoToMatchingBracketCommand}" />
        <KeyBinding Gesture="Ctrl+OemTilde" Command="{Binding RestartTerminalCommand}" />
        <KeyBinding Gesture="Ctrl+J" Command="{Binding ToggleBottomPaneCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+E" Command="{Binding FocusExplorerCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+D" Command="{Binding FocusDebuggerCommand}" />
    </Window.KeyBindings>

    <!-- Global Tab & Dock Control Styling for Visible Document & Tool Tabs -->
    <Window.Styles>
        <Style Selector="dock|DocumentTabStripItem">
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="dock|DocumentTabStripItem TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC" />
        </Style>
        <Style Selector="dock|DocumentTabStripItem:selected TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="dock|DocumentTabStripItem:pointerover TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style Selector="dock|ToolTabStripItem">
            <Setter Property="Foreground" Value="#AAAAAA" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="dock|ToolTabStripItem TextBlock">
            <Setter Property="Foreground" Value="#AAAAAA" />
        </Style>
        <Style Selector="dock|ToolTabStripItem:selected TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="dock|ToolTabStripItem:pointerover TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
    </Window.Styles>

    <Grid>
        <!-- IDE Main Shell Layout -->
        <Grid RowDefinitions="Auto,Auto,*,Auto">
            
            <!-- Menu Bar -->
            <Menu Grid.Row="0" Background="{Binding WindowBackground}">
                <MenuItem Header="_File">
                    <MenuItem Header="_New File" InputGesture="Ctrl+N" Command="{Binding NewFileCommand}" />
                    <MenuItem Header="_Open File..." InputGesture="Ctrl+O" Command="{Binding OpenFileCommand}" />
                    <MenuItem Header="Open _Folder..." Command="{Binding OpenFolderCommand}" />
                    <Separator />
                    <MenuItem Header="_Save" InputGesture="Ctrl+S" Command="{Binding SaveFileCommand}" />
                    <MenuItem Header="Save _As..." InputGesture="Ctrl+Shift+S" Command="{Binding SaveFileAsCommand}" />
                </MenuItem>
                <MenuItem Header="_Edit">
                    <MenuItem Header="Undo" InputGesture="Ctrl+Z" />
                    <MenuItem Header="Redo" InputGesture="Ctrl+Y" />
                    <Separator />
                    <MenuItem Header="Cut" InputGesture="Ctrl+X" />
                    <MenuItem Header="Copy" InputGesture="Ctrl+C" />
                    <MenuItem Header="Paste" InputGesture="Ctrl+V" />
                    <Separator />
                    <MenuItem Header="_Find..." InputGesture="Ctrl+F" Command="{Binding OpenFindCommand}" />
                    <MenuItem Header="_Replace..." InputGesture="Ctrl+H" Command="{Binding OpenReplaceCommand}" />
                    <MenuItem Header="_Go to Line..." InputGesture="Ctrl+G" Command="{Binding OpenGoToLineCommand}" />
                    <MenuItem Header="Go to _Matching Bracket" InputGesture="Ctrl+M" Command="{Binding GoToMatchingBracketCommand}" />
                </MenuItem>
                <MenuItem Header="_Terminal">
                    <MenuItem Header="_Restart Terminal in Workspace" InputGesture="Ctrl+OemTilde" Command="{Binding RestartTerminalCommand}" />
                </MenuItem>
                <MenuItem Header="_Preferences">
                    <MenuItem Header="Color Theme">
                        <MenuItem Header="Lonely Dark" Command="{Binding SetLonelyDarkThemeCommand}" />
                        <MenuItem Header="Solarized Contrast" Command="{Binding SetSolarizedContrastThemeCommand}" />
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="_View">
                    <MenuItem Header="_Command Palette..." InputGesture="Ctrl+P" Command="{Binding OpenCommandPaletteCommand}" />
                    <Separator />
                    <MenuItem Header="Toggle _Bottom Panel" InputGesture="Ctrl+J" Command="{Binding ToggleBottomPaneCommand}" />
                    <MenuItem Header="_Explorer" InputGesture="Ctrl+Shift+E" Command="{Binding FocusExplorerCommand}" />
                    <MenuItem Header="_Terminal" InputGesture="Ctrl+OemTilde" Command="{Binding FocusTerminalCommand}" />
                    <MenuItem Header="_Output" Command="{Binding FocusOutputCommand}" />
                    <MenuItem Header="_TODO Tasks" Command="{Binding FocusTodoCommand}" />
                    <MenuItem Header="_Run &amp; Debug" InputGesture="Ctrl+Shift+D" Command="{Binding FocusDebuggerCommand}" />
                    <Separator />
                    <MenuItem Header="_Reset Panel to Default Sizes" Command="{Binding ResetPaneLayoutCommand}" />
                    <MenuItem Header="_Extensions..." Command="{Binding ShowExtensionsModalCommand}" />
                </MenuItem>
                <MenuItem Header="_Help">
                    <MenuItem Header="Check for _Updates..." Command="{Binding CheckForUpdatesExplicitCommand}" />
                    <MenuItem Header="_About AgduBugdu" Command="{Binding ShowAboutModalCommand}" />
                </MenuItem>
            </Menu>

            <!-- Quick Action / Search Header Bar -->
            <Border Grid.Row="1"
                    Background="{Binding HeaderBackground}"
                    BorderBrush="{Binding BorderBrush}"
                    BorderThickness="0,1,0,1"
                    Padding="12,6">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Workspace Title with Custom App Logo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Image Source="/Assets/agdubugdu-logo.png" Width="20" Height="20" />
                        <TextBlock Text="AgduBugdu" FontWeight="Bold" Foreground="{Binding AccentBrush}" />
                        <TextBlock Text="—" Foreground="#666666" />
                        <TextBlock Text="{Binding ActiveWorkspaceName}" Foreground="#AAAAAA" />
                    </StackPanel>

                    <!-- Center Command Palette Trigger -->
                    <Button Grid.Column="1"
                            HorizontalAlignment="Center"
                            Width="360"
                            Padding="10,4"
                            Background="{Binding WindowBackground}"
                            BorderBrush="{Binding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Command="{Binding OpenCommandPaletteCommand}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="Search files, commands (Ctrl+P)..."
                                       FontSize="12"
                                       Foreground="#71717A"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="1"
                                    Background="#27272A"
                                    CornerRadius="3"
                                    Padding="4,1">
                                <TextBlock Text="Ctrl+P" FontSize="10" Foreground="#A1A1AA" />
                            </Border>
                        </Grid>
                    </Button>

                    <!-- Right Quick Status -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentThemeName}" FontSize="11" Foreground="#71717A" />
                        <TextBlock Text="|" Foreground="#444444" />
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#888888" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Docking Host (Explorer, Editor Tabs, Terminal, Output Pane) -->
            <dock:DockControl Grid.Row="2"
                              Layout="{Binding Layout}"
                              Margin="0" />

            <!-- Dynamic Bottom Status Bar -->
            <Border Grid.Row="3"
                    Background="{Binding StatusBarBackground}"
                    Padding="12,3"
                    Height="24">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Left status -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{Binding StatusBarForeground}" />
                    </StackPanel>

                    <!-- Right details -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CursorPosition}" FontSize="11" Foreground="{Binding StatusBarForeground}" />
                        <TextBlock Text="{Binding Encoding}" FontSize="11" Foreground="{Binding StatusBarForeground}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Command Palette Overlay -->
        <views:CommandPaletteView DataContext="{Binding CommandPalette}" />

        <!-- Auto-Updater Modal Overlay -->
        <views:UpdateModalView DataContext="{Binding UpdateModal}" />

        <!-- Extensions Manager Modal Overlay -->
        <views:ExtensionsModalView DataContext="{Binding ExtensionsModal}" />
        <views:AboutModalView DataContext="{Binding AboutModal}" />
    </Grid>
</Window>
