<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AgduBugdu.App.ViewModels.Documents"
             xmlns:ae="using:AvaloniaEdit"
             x:Class="AgduBugdu.App.Views.Documents.EditorDocumentView"
             x:DataType="vm:EditorDocumentViewModel">

    <Grid Background="#1E1E1E">
        <ae:TextEditor x:Name="Editor"
                       Document="{Binding TextDocument}"
                       ShowLineNumbers="True"
                       FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                       FontSize="14"
                       WordWrap="{Binding WordWrap}"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Visible"
                       Background="#1E1E1E"
                       Foreground="#D4D4D4">
            <ae:TextEditor.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Cut" Command="{Binding $parent[ae:TextEditor].Cut}" InputGesture="Ctrl+X" />
                    <MenuItem Header="Copy" Command="{Binding $parent[ae:TextEditor].Copy}" InputGesture="Ctrl+C" />
                    <MenuItem Header="Paste" Command="{Binding $parent[ae:TextEditor].Paste}" InputGesture="Ctrl+V" />
                    <Separator />
                    <MenuItem Header="Find..." Command="{Binding OpenFindCommand}" InputGesture="Ctrl+F" />
                    <MenuItem Header="Replace..." Command="{Binding OpenReplaceCommand}" InputGesture="Ctrl+H" />
                    <MenuItem Header="Go to Line..." Command="{Binding OpenGoToLineCommand}" InputGesture="Ctrl+G" />
                    <MenuItem Header="Go to Matching Bracket" Command="{Binding GoToMatchingBracketCommand}" InputGesture="Ctrl+M" />
                    <Separator />
                    <MenuItem Header="Toggle Line Comment" Command="{Binding ToggleLineCommentCommand}" InputGesture="Ctrl+OemQuestion" />
                    <MenuItem Header="Toggle Block Comment" Command="{Binding ToggleBlockCommentCommand}" InputGesture="Shift+Alt+A" />
                    <Separator />
                    <MenuItem Header="Move Line Up" Command="{Binding MoveLineUpCommand}" InputGesture="Alt+Up" />
                    <MenuItem Header="Move Line Down" Command="{Binding MoveLineDownCommand}" InputGesture="Alt+Down" />
                    <MenuItem Header="Duplicate Line Down" Command="{Binding DuplicateLineDownCommand}" InputGesture="Shift+Alt+Down" />
                    <MenuItem Header="Delete Line" Command="{Binding DeleteLineCommand}" InputGesture="Ctrl+Shift+K" />
                    <MenuItem Header="Join Lines" Command="{Binding JoinLinesCommand}" InputGesture="Ctrl+Shift+J" />
                    <Separator />
                    <MenuItem Header="Uppercase" Command="{Binding TransformUppercaseCommand}" InputGesture="Ctrl+Shift+U" />
                    <MenuItem Header="Lowercase" Command="{Binding TransformLowercaseCommand}" InputGesture="Ctrl+U" />
                    <Separator />
                    <MenuItem Header="Select All" Command="{Binding $parent[ae:TextEditor].SelectAll}" InputGesture="Ctrl+A" />
                    <Separator />
                    <MenuItem Header="Toggle Breakpoint" x:Name="ToggleBreakpointMenuItem" InputGesture="F9" />
                </ContextMenu>
            </ae:TextEditor.ContextMenu>
        </ae:TextEditor>

        <!-- Find & Replace Floating Panel -->
        <Border IsVisible="{Binding IsFindVisible}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,8,22,0"
                Background="#252526"
                BorderBrush="#3E3E42"
                BorderThickness="1"
                CornerRadius="6"
                Padding="6"
                BoxShadow="0 4 14 0 #60000000"
                Width="390">
            <StackPanel Spacing="6">
                <!-- Find Row -->
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                    <!-- Toggle Replace View -->
                    <Button Grid.Column="0"
                            Command="{Binding ToggleReplaceCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="4,2"
                            Margin="0,0,4,0"
                            ToolTip.Tip="Toggle Replace Mode (Ctrl+H)">
                        <TextBlock Text="⇄"
                                   Foreground="#CCCCCC"
                                   FontSize="12" />
                    </Button>

                    <!-- Search Input -->
                    <TextBox x:Name="SearchBox"
                             Grid.Column="1"
                             Text="{Binding SearchQuery, Mode=TwoWay}"
                             Watermark="Find in document..."
                             FontSize="12"
                             Padding="6,3"
                             Height="26"
                             VerticalContentAlignment="Center"
                             Background="#1E1E1E"
                             Foreground="#F1F1F1"
                             BorderBrush="#3E3E42"
                             BorderThickness="1"
                             CornerRadius="3" />

                    <!-- Search Match Count / Status -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding SearchMatchStatus}"
                               Foreground="#888888"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="6,0,6,0" />

                    <!-- Match Case Button -->
                    <ToggleButton Grid.Column="3"
                                  IsChecked="{Binding MatchCase, Mode=TwoWay}"
                                  Padding="4,2"
                                  Height="24"
                                  Margin="1,0"
                                  ToolTip.Tip="Match Case (Alt+C)"
                                  Background="Transparent"
                                  BorderThickness="0">
                        <TextBlock Text="Aa" FontSize="11" FontWeight="Bold" />
                    </ToggleButton>

                    <!-- Match Whole Word Button -->
                    <ToggleButton Grid.Column="4"
                                  IsChecked="{Binding MatchWholeWord, Mode=TwoWay}"
                                  Padding="4,2"
                                  Height="24"
                                  Margin="1,0"
                                  ToolTip.Tip="Match Whole Word (Alt+W)"
                                  Background="Transparent"
                                  BorderThickness="0">
                        <TextBlock Text="|b|" FontSize="11" FontWeight="Bold" />
                    </ToggleButton>

                    <!-- Use Regular Expressions Button -->
                    <ToggleButton Grid.Column="5"
                                  IsChecked="{Binding UseRegex, Mode=TwoWay}"
                                  Padding="4,2"
                                  Height="24"
                                  Margin="1,0"
                                  ToolTip.Tip="Use Regular Expressions (Alt+R)"
                                  Background="Transparent"
                                  BorderThickness="0">
                        <TextBlock Text=".*" FontSize="11" FontWeight="Bold" />
                    </ToggleButton>
                </Grid>

                <!-- Navigation & Action Buttons Row for Find -->
                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <Button Command="{Binding FindPreviousCommand}"
                                ToolTip.Tip="Previous Match (Shift+Enter / Shift+F3)"
                                Padding="8,2"
                                Height="24"
                                Background="#333333"
                                BorderThickness="0"
                                CornerRadius="3">
                            <TextBlock Text="▲" FontSize="10" Foreground="#CCCCCC" />
                        </Button>
                        <Button Command="{Binding FindNextCommand}"
                                ToolTip.Tip="Next Match (Enter / F3)"
                                Padding="8,2"
                                Height="24"
                                Background="#333333"
                                BorderThickness="0"
                                CornerRadius="3">
                            <TextBlock Text="▼" FontSize="10" Foreground="#CCCCCC" />
                        </Button>
                    </StackPanel>

                    <Button Grid.Column="3"
                            Command="{Binding CloseFindCommand}"
                            ToolTip.Tip="Close (Esc)"
                            Padding="6,2"
                            Height="24"
                            Margin="6,0,0,0"
                            Background="Transparent"
                            BorderThickness="0">
                        <TextBlock Text="✕" FontSize="11" Foreground="#CCCCCC" />
                    </Button>
                </Grid>

                <!-- Replace Row -->
                <Grid ColumnDefinitions="*,Auto,Auto"
                      IsVisible="{Binding IsReplaceVisible}"
                      Margin="0,2,0,0">
                    <TextBox x:Name="ReplaceBox"
                             Grid.Column="0"
                             Text="{Binding ReplaceQuery, Mode=TwoWay}"
                             Watermark="Replace with..."
                             FontSize="12"
                             Padding="6,3"
                             Height="26"
                             VerticalContentAlignment="Center"
                             Background="#1E1E1E"
                             Foreground="#F1F1F1"
                             BorderBrush="#3E3E42"
                             BorderThickness="1"
                             CornerRadius="3" />

                    <Button Grid.Column="1"
                            Command="{Binding ReplaceCurrentCommand}"
                            ToolTip.Tip="Replace Current (Enter)"
                            Padding="8,2"
                            Height="24"
                            Margin="4,0,2,0"
                            Background="#333333"
                            BorderThickness="0"
                            CornerRadius="3">
                        <TextBlock Text="Replace" FontSize="11" Foreground="#CCCCCC" />
                    </Button>

                    <Button Grid.Column="2"
                            Command="{Binding ReplaceAllCommand}"
                            ToolTip.Tip="Replace All"
                            Padding="8,2"
                            Height="24"
                            Margin="2,0,0,0"
                            Background="#333333"
                            BorderThickness="0"
                            CornerRadius="3">
                        <TextBlock Text="All" FontSize="11" Foreground="#CCCCCC" />
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Go To Line / Column Overlay -->
        <Border IsVisible="{Binding IsGoToLineVisible}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,18,0,0"
                Background="#252526"
                BorderBrush="#007ACC"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8"
                BoxShadow="0 4 16 0 #70000000"
                Width="320">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding GoToLinePrompt}"
                           FontSize="11"
                           Foreground="#AAAAAA" />
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBox x:Name="GoToLineBox"
                             Grid.Column="0"
                             Text="{Binding GoToLineInput, Mode=TwoWay}"
                             Watermark="e.g. 42 or 42:10"
                             FontSize="13"
                             Padding="6,4"
                             Height="28"
                             VerticalContentAlignment="Center"
                             Background="#1E1E1E"
                             Foreground="#F1F1F1"
                             BorderBrush="#3E3E42"
                             BorderThickness="1"
                             CornerRadius="3" />
                    <Button Grid.Column="1"
                            Command="{Binding ConfirmGoToLineCommand}"
                            Padding="10,2"
                            Height="28"
                            Margin="4,0,0,0"
                            Background="#007ACC"
                            BorderThickness="0"
                            CornerRadius="3">
                        <TextBlock Text="Go" FontSize="11" Foreground="White" FontWeight="SemiBold" />
                    </Button>
                    <Button Grid.Column="2"
                            Command="{Binding CancelGoToLineCommand}"
                            Padding="8,2"
                            Height="28"
                            Margin="4,0,0,0"
                            Background="#333333"
                            BorderThickness="0"
                            CornerRadius="3">
                        <TextBlock Text="✕" FontSize="11" Foreground="#CCCCCC" />
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
