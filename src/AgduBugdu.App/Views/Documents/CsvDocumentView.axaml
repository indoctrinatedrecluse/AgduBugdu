<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AgduBugdu.App.ViewModels.Documents"
             xmlns:data="clr-namespace:AgduBugdu.Plugin.DataGridLive;assembly=AgduBugdu.Plugin.DataGridLive"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             x:Class="AgduBugdu.App.Views.Documents.CsvDocumentView"
             x:DataType="vm:CsvDocumentViewModel"
             Background="#1E1E1E">

    <Grid RowDefinitions="Auto,*">
        <!-- Control Toolbar -->
        <Border Grid.Row="0"
                Background="#252526"
                BorderBrush="#333333"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Title & Filter -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="📊" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />

                    <Border Background="#1E1E1E" CornerRadius="4" BorderBrush="#3C3C3C" BorderThickness="1" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox Text="{Binding SearchQuery, Mode=TwoWay}"
                                     Watermark="Filter records..."
                                     Width="220"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="#CCCCCC"
                                     Padding="8,4" />
                            <Button Command="{Binding ClearFilterCommand}"
                                    IsVisible="{Binding SearchQuery.Length}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="4,2"
                                    ToolTip.Tip="Clear search">
                                <TextBlock Text="✕" FontSize="11" Foreground="#888888" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding ReloadCommand}"
                            Background="#333333"
                            Foreground="#EEEEEE"
                            BorderBrush="#444444"
                            Padding="8,4"
                            CornerRadius="4"
                            ToolTip.Tip="Reload file">
                        <TextBlock Text="↻ Refresh" FontSize="12" />
                    </Button>
                </StackPanel>

                <!-- Status Summary -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Background="#2D2D30" CornerRadius="4" Padding="8,4">
                        <TextBlock Text="{Binding StatusSummary}"
                                   FontSize="12"
                                   Foreground="#9CDCFE"
                                   VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Data Viewport -->
        <Grid Grid.Row="1">
            <!-- Loading Indicator -->
            <StackPanel IsVisible="{Binding IsLoading}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <TextBlock Text="⏳ Parsing dataset..." Foreground="#AAAAAA" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Error Banner -->
            <Border IsVisible="{Binding HasError}"
                    Background="#3A1D1D"
                    BorderBrush="#F44336"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="24"
                    Padding="16"
                    VerticalAlignment="Top">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF6B6B" TextWrapping="Wrap" />
            </Border>

            <!-- Scrollable Table Matrix -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding !IsLoading}">
                <StackPanel Orientation="Vertical">
                    <!-- Fixed Header Row -->
                    <Border Background="#252526"
                            BorderBrush="#383838"
                            BorderThickness="0,0,0,2">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="55"
                                    Padding="8,6"
                                    BorderBrush="#383838"
                                    BorderThickness="0,0,1,0"
                                    Background="#222222">
                                <TextBlock Text="#"
                                           FontWeight="Bold"
                                           Foreground="#858585"
                                           HorizontalAlignment="Center" />
                            </Border>

                            <ItemsControl ItemsSource="{Binding Headers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="160"
                                                Padding="8,6"
                                                BorderBrush="#383838"
                                                BorderThickness="0,0,1,0">
                                            <TextBlock Text="{Binding}"
                                                       FontWeight="Bold"
                                                       Foreground="#DCDCDC"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Data Rows ListBox -->
                    <ListBox ItemsSource="{Binding DisplayRows}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="data:CsvRowItem">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="55"
                                            Padding="8,4"
                                            BorderBrush="#2A2A2A"
                                            BorderThickness="0,0,1,0">
                                        <TextBlock Text="{Binding Index}"
                                                   Foreground="#707070"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding Values}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="160"
                                                        Padding="8,4"
                                                        BorderBrush="#252525"
                                                        BorderThickness="0,0,1,0">
                                                    <SelectableTextBlock Text="{Binding}"
                                                                         Foreground="#E0E0E0"
                                                                         FontSize="12"
                                                                         TextTrimming="CharacterEllipsis"
                                                                         ToolTip.Tip="{Binding}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
