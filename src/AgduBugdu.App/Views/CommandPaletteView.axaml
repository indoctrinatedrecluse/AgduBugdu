<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AgduBugdu.App.ViewModels"
             x:Class="AgduBugdu.App.Views.CommandPaletteView"
             x:DataType="vm:CommandPaletteViewModel">

    <!-- Modal backdrop -->
    <Grid Background="#66000000"
          IsVisible="{Binding IsOpen}">

        <Border Width="560"
                MaxHeight="400"
                VerticalAlignment="Top"
                Margin="0,48,0,0"
                Background="#252526"
                CornerRadius="8"
                BorderBrush="#3F3F46"
                BorderThickness="1"
                BoxShadow="0 8 32 #AA000000">

            <Grid RowDefinitions="Auto,*">
                <!-- Search input box -->
                <TextBox Grid.Row="0"
                         x:Name="SearchBox"
                         Text="{Binding SearchText, Mode=TwoWay}"
                         Watermark="Type a command or search..."
                         FontSize="14"
                         Padding="12,10"
                         Margin="8,8,8,4"
                         Background="#1E1E1E"
                         BorderBrush="#007ACC"
                         BorderThickness="1"
                         CornerRadius="4" />

                <!-- Results list -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding FilteredCommands}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         Background="Transparent"
                         Margin="8,4,8,8"
                         CornerRadius="4">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:CommandPaletteItem">
                            <Grid ColumnDefinitions="*,Auto" Margin="4,2">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Title}"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="1"
                                        Background="#333333"
                                        CornerRadius="3"
                                        Padding="6,2"
                                        IsVisible="{Binding Shortcut, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="{Binding Shortcut}"
                                               FontSize="11"
                                               Foreground="#AAAAAA"
                                               FontFamily="Cascadia Code, Consolas, monospace" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
