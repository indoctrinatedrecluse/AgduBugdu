<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AgduBugdu.App.ViewModels.Tools"
             xmlns:docker="using:AgduBugdu.Core.Docker"
             x:Class="AgduBugdu.App.Views.Tools.DockerToolView"
             x:DataType="vm:DockerToolViewModel">

    <Grid RowDefinitions="Auto,*" Background="#1E1E1E">
        <!-- Top Docker Toolbar Strip -->
        <Border Grid.Row="0"
                Padding="8,6"
                Background="#252526"
                BorderBrush="#333333"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <!-- Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="🐳" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="DOCKER WORKBENCH"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#AAAAAA"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Tab Selectors -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <RadioButton Content="Containers"
                                 IsChecked="{Binding SelectedTabIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}"
                                 GroupName="DockerTabs"
                                 FontSize="11"
                                 Padding="8,3" />
                    <RadioButton Content="Images"
                                 IsChecked="{Binding SelectedTabIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=1}"
                                 GroupName="DockerTabs"
                                 FontSize="11"
                                 Padding="8,3" />
                </StackPanel>

                <!-- Daemon Status -->
                <Border Grid.Column="2" Background="#181818" CornerRadius="3" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DaemonStatus}" FontSize="10" Foreground="#00D26A" />
                </Border>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Content="🔄 Refresh" Command="{Binding RefreshContainersCommand}" Background="#333333" Foreground="#CCCCCC" FontSize="10" Padding="8,4" CornerRadius="3" />
                    <Button Content="🧹 Prune Stopped" Command="{Binding PruneContainersCommand}" Background="#333333" Foreground="#EF4444" FontSize="10" Padding="8,4" CornerRadius="3" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Row="1">
            <!-- 1. Containers Tab View -->
            <Grid ColumnDefinitions="*,4,*" IsVisible="{Binding SelectedTabIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}">
                <!-- Left: Container List Pane -->
                <Grid Grid.Column="0" RowDefinitions="Auto,*">
                    <!-- Search & Filter Bar -->
                    <Border Grid.Row="0" Background="#181818" BorderBrush="#2D2D30" BorderThickness="0,0,0,1" Padding="6,4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Text="{Binding SearchText, Mode=TwoWay}" Watermark="Filter containers by name or image..." FontSize="11" Height="26" VerticalContentAlignment="Center" Background="#252526" Foreground="#EEEEEE" BorderBrush="#3E3E42" Margin="0,0,6,0" />
                            <CheckBox Grid.Column="1" Content="Running only" IsChecked="{Binding ShowOnlyRunning, Mode=TwoWay}" FontSize="11" Foreground="#AAAAAA" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Container List -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding FilteredContainers}" SelectedItem="{Binding SelectedContainer, Mode=TwoWay}" Background="#121212" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="docker:DockerContainerItem">
                                <Border BorderBrush="#202020" BorderThickness="0,0,0,1" Padding="6,4">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- State indicator -->
                                        <Border Grid.Column="0" Background="{Binding StateBadgeColor}" CornerRadius="3" Padding="4,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding State}" FontSize="9" FontWeight="Bold" Foreground="White" />
                                        </Border>

                                        <!-- Container details -->
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#EEEEEE" />
                                            <TextBlock Text="{Binding Image}" FontSize="10" Foreground="#888888" />
                                            <TextBlock Text="{Binding Status}" FontSize="9" Foreground="#666666" />
                                        </StackPanel>

                                        <!-- Quick Actions -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                            <Button Content="▶" ToolTip.Tip="Start container" IsVisible="{Binding !IsRunning}" Command="{Binding $parent[UserControl].((vm:DockerToolViewModel)DataContext).StartContainerCommand}" CommandParameter="{Binding}" Background="#059669" Foreground="White" FontSize="9" Padding="6,2" CornerRadius="3" />
                                            <Button Content="⏹" ToolTip.Tip="Stop container" IsVisible="{Binding IsRunning}" Command="{Binding $parent[UserControl].((vm:DockerToolViewModel)DataContext).StopContainerCommand}" CommandParameter="{Binding}" Background="#DC2626" Foreground="White" FontSize="9" Padding="6,2" CornerRadius="3" />
                                            <Button Content="🔄" ToolTip.Tip="Restart container" Command="{Binding $parent[UserControl].((vm:DockerToolViewModel)DataContext).RestartContainerCommand}" CommandParameter="{Binding}" Background="#333333" Foreground="#CCCCCC" FontSize="9" Padding="6,2" CornerRadius="3" />
                                            <Button Content="🗑" ToolTip.Tip="Remove container" Command="{Binding $parent[UserControl].((vm:DockerToolViewModel)DataContext).RemoveContainerCommand}" CommandParameter="{Binding}" Background="#333333" Foreground="#EF4444" FontSize="9" Padding="6,2" CornerRadius="3" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <GridSplitter Grid.Column="1" Width="4" Background="#333333" />

                <!-- Right: Container Details & Logs Pane -->
                <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*" Margin="4">
                    <!-- Selected Container Card Header -->
                    <Border Grid.Row="0" Background="#252526" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,4">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding SelectedContainer.Name, FallbackValue='No container selected'}" FontSize="13" FontWeight="Bold" Foreground="#60A5FA" />
                                    <TextBlock Text="{Binding SelectedContainer.ShortId, StringFormat='({0})'}" FontSize="11" Foreground="#888888" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedContainer.Image, StringFormat='Image: {0}'}" FontSize="10" Foreground="#AAAAAA" />
                                <TextBlock Text="{Binding SelectedContainer.Ports, StringFormat='Ports: {0}'}" FontSize="10" Foreground="#10B981" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Content=">_ Attach Shell" Command="{Binding AttachTerminalCommand}" CommandParameter="{Binding SelectedContainer}" Background="#0284C7" Foreground="White" FontSize="10" Padding="8,4" CornerRadius="3" />
                                <Button Content="Clear Logs" Command="{Binding ClearLogsCommand}" Background="#333333" Foreground="#CCCCCC" FontSize="10" Padding="6,4" CornerRadius="3" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="1" Text="CONTAINER LOGS (STDOUT / STDERR)" FontSize="10" FontWeight="Bold" Foreground="#888888" Margin="2,2,0,4" />

                    <!-- Logs Console Box -->
                    <TextBox Grid.Row="2" Text="{Binding ContainerLogs}" IsReadOnly="True" FontFamily="Cascadia Code, Consolas, monospace" FontSize="11" Background="#0C0C0C" Foreground="#CCCCCC" BorderBrush="#333333" AcceptsReturn="True" TextWrapping="Wrap" />
                </Grid>
            </Grid>

            <!-- 2. Images Tab View -->
            <Grid RowDefinitions="Auto,*" IsVisible="{Binding SelectedTabIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=1}">
                <Border Grid.Row="0" Background="#181818" BorderBrush="#2D2D30" BorderThickness="0,0,0,1" Padding="8,6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="LOCAL DOCKER IMAGES" FontSize="11" FontWeight="Bold" Foreground="#888888" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="🔄 Refresh Images" Command="{Binding RefreshImagesCommand}" Background="#333333" Foreground="#CCCCCC" FontSize="10" Padding="8,4" CornerRadius="3" />
                    </Grid>
                </Border>

                <!-- Images List -->
                <ListBox Grid.Row="1" ItemsSource="{Binding Images}" Background="#121212" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="docker:DockerImageItem">
                            <Border BorderBrush="#202020" BorderThickness="0,0,0,1" Padding="8,6">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding FullName}" FontSize="12" FontWeight="SemiBold" Foreground="#F3E8FF" />
                                        <TextBlock Text="{Binding ShortId, StringFormat='ID: {0}'}" FontSize="10" Foreground="#666666" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Size}" FontSize="11" Foreground="#10B981" Margin="12,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Created}" FontSize="10" Foreground="#888888" Margin="12,0" VerticalAlignment="Center" />
                                    <Button Grid.Column="3" Content="🗑 Delete" Command="{Binding $parent[UserControl].((vm:DockerToolViewModel)DataContext).RemoveImageCommand}" CommandParameter="{Binding}" Background="#333333" Foreground="#EF4444" FontSize="10" Padding="8,4" CornerRadius="3" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
