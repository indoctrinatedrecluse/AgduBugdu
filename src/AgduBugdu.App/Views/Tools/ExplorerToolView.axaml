<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AgduBugdu.App.ViewModels.Tools"
             x:Class="AgduBugdu.App.Views.Tools.ExplorerToolView"
             x:DataType="vm:ExplorerToolViewModel">

    <Grid RowDefinitions="Auto,*">
        <!-- Explorer Header -->
        <Border Grid.Row="0"
                Padding="12,8"
                BorderBrush="#333333"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="WORKSPACE EXPLORER"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#888888"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Placeholder for TreeDataGrid file system view -->
        <Border Grid.Row="1" Padding="16">
            <StackPanel Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="No folder opened"
                           Foreground="#888888"
                           FontSize="13"
                           HorizontalAlignment="Center" />
                <Button Content="Open Folder..."
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Padding="12,6" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
