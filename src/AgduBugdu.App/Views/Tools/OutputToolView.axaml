<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AgduBugdu.App.ViewModels.Tools"
             x:Class="AgduBugdu.App.Views.Tools.OutputToolView"
             x:DataType="vm:OutputToolViewModel">

    <Grid RowDefinitions="Auto,*">
        <!-- Output Header -->
        <Border Grid.Row="0"
                Padding="12,6"
                Background="#252526"
                BorderBrush="#333333"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="OUTPUT"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#888888"
                               VerticalAlignment="Center" />
                    <TextBlock Text="AgduBugdu System Log"
                               FontSize="11"
                               Foreground="#AAAAAA"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button Content="Clear"
                            FontSize="10"
                            Padding="6,2"
                            Background="#333333"
                            Foreground="#EEEEEE"
                            CornerRadius="3"
                            Command="{Binding ClearCommand}" />
                    <Button Content="🗕"
                            ToolTip.Tip="Minimize bottom panel"
                            FontSize="10"
                            Padding="6,2"
                            Background="#333333"
                            Foreground="#EEEEEE"
                            CornerRadius="3"
                            Command="{Binding MinimizeCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Log Display -->
        <TextBox Grid.Row="1"
                 IsReadOnly="True"
                 FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                 FontSize="12"
                 Background="#141414"
                 Foreground="#CCCCCC"
                 BorderThickness="0"
                 Text="{Binding OutputText}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap" />
    </Grid>
</UserControl>
