<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AgduBugdu.App.ViewModels.Tools"
             x:Class="AgduBugdu.App.Views.Tools.OutputToolView"
             x:DataType="vm:OutputToolViewModel">

    <Grid RowDefinitions="Auto,*">
        <!-- Output Header -->
        <Border Grid.Row="0"
                Padding="12,6"
                Background="#252526"
                BorderBrush="#333333"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="OUTPUT"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#888888"
                               VerticalAlignment="Center" />
                    <TextBlock Text="AgduBugdu System Log"
                               FontSize="11"
                               Foreground="#AAAAAA"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="🗕 Minimize"
                        ToolTip.Tip="Reset pane to original size"
                        FontSize="10"
                        Padding="6,2"
                        Background="#333333"
                        Foreground="#EEEEEE"
                        CornerRadius="3"
                        Command="{Binding ResetSizeCommand}" />
            </Grid>
        </Border>

        <!-- Log Display -->
        <TextBox Grid.Row="1"
                 IsReadOnly="True"
                 FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                 FontSize="12"
                 Background="#141414"
                 Foreground="#CCCCCC"
                 BorderThickness="0"
                 Text="[System] AgduBugdu IDE initialized.&#x0a;[Extensibility] Extension subsystem ready.&#x0a;[Theme] FluentAvalonia Dark theme active."
                 AcceptsReturn="True"
                 TextWrapping="NoWrap" />
    </Grid>
</UserControl>
