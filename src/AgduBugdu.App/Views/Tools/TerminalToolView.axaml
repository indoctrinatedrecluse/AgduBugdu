<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AgduBugdu.App.ViewModels.Tools"
             x:Class="AgduBugdu.App.Views.Tools.TerminalToolView"
             x:DataType="vm:TerminalToolViewModel">

    <UserControl.Styles>
        <Style Selector="Border.terminal-tab">
            <Setter Property="Background" Value="#252526" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="BorderBrush" Value="#333333" />
            <Setter Property="CornerRadius" Value="4,4,0,0" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.terminal-tab:pointerover">
            <Setter Property="Background" Value="#2D2D30" />
        </Style>
        <Style Selector="Border.terminal-tab.active">
            <Setter Property="Background" Value="#0C0C0C" />
            <Setter Property="BorderBrush" Value="#007ACC" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Terminal Header & Tabs Strip -->
        <Border Grid.Row="0"
                Padding="8,4,8,0"
                Background="#1E1E1E"
                BorderBrush="#333333"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,8,4">
                    <TextBlock Text="TERMINAL"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#888888"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Scrollable Tab Strip -->
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <ItemsControl ItemsSource="{Binding Sessions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="terminal-tab" Classes.active="{Binding IsSelected}">
                                        <Border.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuItem Header="Close Tab"
                                                          Command="{Binding $parent[UserControl].((vm:TerminalToolViewModel)DataContext).CloseSessionCommand}"
                                                          CommandParameter="{Binding}" />
                                            </MenuFlyout>
                                        </Border.ContextFlyout>
                                        <Grid ColumnDefinitions="Auto,Auto,Auto" VerticalAlignment="Center">
                                            <!-- Shell Icon -->
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Icon}"
                                                       FontSize="11"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center" />
                                            <!-- Tab Title (clickable to select) -->
                                            <Button Grid.Column="1"
                                                    Content="{Binding Title}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    FontSize="11"
                                                    Foreground="#DDDDDD"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding $parent[UserControl].((vm:TerminalToolViewModel)DataContext).SelectSessionCommand}"
                                                    CommandParameter="{Binding}" />
                                            <!-- Close Tab Button -->
                                            <Button Grid.Column="2"
                                                    Content="✕"
                                                    FontSize="9"
                                                    Padding="4,1"
                                                    Margin="6,0,0,0"
                                                    Background="Transparent"
                                                    Foreground="#888888"
                                                    BorderThickness="0"
                                                    VerticalAlignment="Center"
                                                    ToolTip.Tip="Close session"
                                                    Command="{Binding $parent[UserControl].((vm:TerminalToolViewModel)DataContext).CloseSessionCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Add Session Button with Menu Flyout -->
                        <Button Content="+"
                                FontSize="12"
                                FontWeight="Bold"
                                Padding="6,2"
                                Margin="4,0,0,2"
                                Background="#2A2A2D"
                                Foreground="#CCCCCC"
                                CornerRadius="3"
                                ToolTip.Tip="New Terminal Session">
                            <Button.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuItem Header="PowerShell"
                                              Command="{Binding AddPowerShellCommand}" />
                                    <MenuItem Header="Command Prompt (cmd)"
                                              Command="{Binding AddCommandPromptCommand}" />
                                    <MenuItem Header="Git Bash"
                                              Command="{Binding AddGitBashCommand}" />
                                    <MenuItem Header="WSL (Bash)"
                                              Command="{Binding AddWslCommand}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Action Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="8,0,0,4">
                    <Button Content="🔍"
                            ToolTip.Tip="Search output"
                            FontSize="11"
                            Padding="5,2"
                            Background="#333333"
                            Foreground="#EEEEEE"
                            CornerRadius="3"
                            Command="{Binding ToggleSearchCommand}" />
                    <Button Content="◫ Split"
                            ToolTip.Tip="Toggle side-by-side terminal split"
                            FontSize="10"
                            Padding="6,2"
                            Background="#333333"
                            Foreground="#EEEEEE"
                            CornerRadius="3"
                            Command="{Binding ToggleSplitViewCommand}" />
                    <Button Content="Clear"
                            FontSize="10"
                            Padding="6,2"
                            Background="#333333"
                            Foreground="#EEEEEE"
                            CornerRadius="3"
                            Command="{Binding ClearTerminalCommand}" />
                    <Button Content="🗕"
                            ToolTip.Tip="Minimize bottom panel"
                            FontSize="10"
                            Padding="6,2"
                            Background="#333333"
                            Foreground="#EEEEEE"
                            CornerRadius="3"
                            Command="{Binding MinimizeCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Search Bar Overlay (Row 1) -->
        <Border Grid.Row="1"
                Background="#2D2D30"
                BorderBrush="#3E3E42"
                BorderThickness="0,0,0,1"
                Padding="8,4"
                IsVisible="{Binding IsSearchVisible}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <TextBlock Grid.Column="0"
                           Text="Find:"
                           FontSize="11"
                           Foreground="#AAAAAA"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <TextBox Grid.Column="1"
                         Text="{Binding SearchText, Mode=TwoWay}"
                         Watermark="Search terminal text..."
                         FontSize="11"
                         Height="24"
                         Padding="4,2"
                         Background="#1E1E1E"
                         Foreground="#EEEEEE"
                         BorderBrush="#444444"
                         VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="{Binding SearchMatchCount, StringFormat='{}{0} matches'}"
                           FontSize="11"
                           Foreground="#888888"
                           VerticalAlignment="Center"
                           Margin="8,0" />
                <Button Grid.Column="3"
                        Content="✕"
                        FontSize="10"
                        Padding="6,2"
                        Background="Transparent"
                        Foreground="#AAAAAA"
                        BorderThickness="0"
                        ToolTip.Tip="Close search"
                        Command="{Binding ToggleSearchCommand}" />
            </Grid>
        </Border>

        <!-- Terminal Panes (Row 2) -->
        <Grid Grid.Row="2">
            <!-- Single Session Pane -->
            <Grid RowDefinitions="*,Auto" IsVisible="{Binding !IsSplitView}">
                <TextBox Grid.Row="0"
                         x:Name="OutputBox"
                         Text="{Binding SelectedSession.TerminalOutput}"
                         IsReadOnly="True"
                         FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                         FontSize="12"
                         Background="#0C0C0C"
                         Foreground="#CCCCCC"
                         BorderThickness="0"
                         AcceptsReturn="True"
                         TextWrapping="Wrap" />
                <Border Grid.Row="1"
                        Background="#181818"
                        BorderBrush="#333333"
                        BorderThickness="0,1,0,0"
                        Padding="6,4">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="$ "
                                   FontFamily="Cascadia Code, Consolas, monospace"
                                   FontWeight="Bold"
                                   Foreground="#10B981"
                                   VerticalAlignment="Center"
                                   Margin="4,0,4,0" />
                        <TextBox Grid.Column="1"
                                 x:Name="InputBox"
                                 Text="{Binding SelectedSession.CommandInput, Mode=TwoWay}"
                                 Watermark="Enter command..."
                                 FontFamily="Cascadia Code, Consolas, monospace"
                                 FontSize="12"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VerticalAlignment="Center" />
                        <Button Grid.Column="2"
                                Content="Send"
                                FontSize="11"
                                Padding="8,4"
                                Background="#2563EB"
                                Foreground="#FFFFFF"
                                CornerRadius="3"
                                Command="{Binding SelectedSession.SendCommandCommand}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Split View Panes -->
            <Grid ColumnDefinitions="*,4,*" IsVisible="{Binding IsSplitView}">
                <!-- Left / Primary Pane -->
                <Grid Grid.Column="0" RowDefinitions="*,Auto">
                    <TextBox Grid.Row="0"
                             Text="{Binding SelectedSession.TerminalOutput}"
                             IsReadOnly="True"
                             FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                             FontSize="12"
                             Background="#0C0C0C"
                             Foreground="#CCCCCC"
                             BorderThickness="0"
                             AcceptsReturn="True"
                             TextWrapping="Wrap" />
                    <Border Grid.Row="1"
                            Background="#181818"
                            BorderBrush="#333333"
                            BorderThickness="0,1,0,0"
                            Padding="6,4">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="$ "
                                       FontFamily="Cascadia Code, Consolas, monospace"
                                       FontWeight="Bold"
                                       Foreground="#10B981"
                                       VerticalAlignment="Center"
                                       Margin="4,0,4,0" />
                            <TextBox Grid.Column="1"
                                     x:Name="SplitInputBox1"
                                     Text="{Binding SelectedSession.CommandInput, Mode=TwoWay}"
                                     Watermark="Enter command..."
                                     FontFamily="Cascadia Code, Consolas, monospace"
                                     FontSize="12"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     VerticalAlignment="Center" />
                            <Button Grid.Column="2"
                                    Content="Send"
                                    FontSize="11"
                                    Padding="8,4"
                                    Background="#2563EB"
                                    Foreground="#FFFFFF"
                                    CornerRadius="3"
                                    Command="{Binding SelectedSession.SendCommandCommand}" />
                        </Grid>
                    </Border>
                </Grid>

                <GridSplitter Grid.Column="1"
                              Width="4"
                              Background="#333333" />

                <!-- Right / Secondary Pane -->
                <Grid Grid.Column="2" RowDefinitions="*,Auto">
                    <TextBox Grid.Row="0"
                             Text="{Binding SplitSession.TerminalOutput}"
                             IsReadOnly="True"
                             FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                             FontSize="12"
                             Background="#0C0C0C"
                             Foreground="#CCCCCC"
                             BorderThickness="0"
                             AcceptsReturn="True"
                             TextWrapping="Wrap" />
                    <Border Grid.Row="1"
                            Background="#181818"
                            BorderBrush="#333333"
                            BorderThickness="0,1,0,0"
                            Padding="6,4">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="$ "
                                       FontFamily="Cascadia Code, Consolas, monospace"
                                       FontWeight="Bold"
                                       Foreground="#60A5FA"
                                       VerticalAlignment="Center"
                                       Margin="4,0,4,0" />
                            <TextBox Grid.Column="1"
                                     x:Name="SplitInputBox2"
                                     Text="{Binding SplitSession.CommandInput, Mode=TwoWay}"
                                     Watermark="Enter command for split session..."
                                     FontFamily="Cascadia Code, Consolas, monospace"
                                     FontSize="12"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     VerticalAlignment="Center" />
                            <Button Grid.Column="2"
                                    Content="Send"
                                    FontSize="11"
                                    Padding="8,4"
                                    Background="#2563EB"
                                    Foreground="#FFFFFF"
                                    CornerRadius="3"
                                    Command="{Binding SplitSession.SendCommandCommand}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
