<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AgduBugdu.App.ViewModels.Tools"
             xmlns:plugin="using:AgduBugdu.Plugin.TodoExplorer"
             x:Class="AgduBugdu.App.Views.Tools.TodoToolView"
             x:DataType="vm:TodoToolViewModel">

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Border Grid.Row="0"
                Padding="12,6"
                Background="#252526"
                BorderBrush="#333333"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="TODO &amp; TASKS"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#888888"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusSummary}"
                               FontSize="11"
                               Foreground="#AAAAAA"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button Content="Refresh"
                            FontSize="10"
                            Padding="6,2"
                            Background="#333333"
                            Foreground="#EEEEEE"
                            CornerRadius="3"
                            Command="{Binding RefreshCommand}" />
                    <Button Content="🗕"
                            ToolTip.Tip="Minimize bottom panel"
                            FontSize="10"
                            Padding="6,2"
                            Background="#333333"
                            Foreground="#EEEEEE"
                            CornerRadius="3"
                            Command="{Binding MinimizeCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Empty State Message -->
        <TextBlock Grid.Row="1"
                   Text="{Binding FormattedContent}"
                   Foreground="#888888"
                   FontSize="12"
                   Margin="16"
                   IsVisible="{Binding !FilteredItems.Count}"
                   TextWrapping="Wrap" />

        <!-- Interactive Task List Display -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding FilteredItems}"
                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                 IsVisible="{Binding FilteredItems.Count}"
                 Background="#141414"
                 Margin="0">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="plugin:TodoItem">
                    <Grid ColumnDefinitions="Auto,Auto,*" Margin="2,2">
                        <!-- Tag Badge -->
                        <Border Grid.Column="0"
                                CornerRadius="3"
                                Padding="6,1"
                                Margin="0,0,8,0"
                                Background="#1F2937">
                            <TextBlock Text="{Binding Tag}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#60A5FA" />
                        </Border>

                        <!-- Location (File:Line) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RelativePath}"
                                       FontSize="11"
                                       Foreground="#A1A1AA" />
                            <TextBlock Text=":" Foreground="#71717A" FontSize="11" />
                            <TextBlock Text="{Binding LineNumber}"
                                       FontSize="11"
                                       Foreground="#D4D4D8"
                                       FontWeight="SemiBold" />
                        </StackPanel>

                        <!-- Message -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Message}"
                                   FontSize="12"
                                   Foreground="#F4F4F5"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
