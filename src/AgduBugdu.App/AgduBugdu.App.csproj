<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>AgduBugdu</AssemblyName>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets\agdubugdu-logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.2" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.2" />
    <!-- Condition below is needed to remove diagnostics in IDE: https://preview.avaloniaui.net/docs/guides/development-guides/setting-up-a-development-environment#guidelines -->
    <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="11.3.2" />
    
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.1.0" />
    <PackageReference Include="AvaloniaEdit.TextMate" Version="11.1.0" />
    <PackageReference Include="Avalonia.Controls.TreeDataGrid" Version="11.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Dock.Avalonia" Version="11.3.2" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="11.3.2" />
    <PackageReference Include="Dock.Model.Mvvm" Version="11.3.2" />
    <PackageReference Include="FluentAvaloniaUI" Version="2.1.0" />
    <PackageReference Include="FluentIcons.Avalonia" Version="1.1.225" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgduBugdu.Core\AgduBugdu.Core.csproj" />
    <ProjectReference Include="..\AgduBugdu.Extensibility\AgduBugdu.Extensibility.csproj" />
    <ProjectReference Include="..\AgduBugdu.Infrastructure\AgduBugdu.Infrastructure.csproj" />
    <ProjectReference Include="..\AgduBugdu.PluginContracts\AgduBugdu.PluginContracts.csproj" />
    <ProjectReference Include="..\..\plugins\AgduBugdu.Plugin.MarkdownLive\AgduBugdu.Plugin.MarkdownLive.csproj" />
    <ProjectReference Include="..\..\plugins\AgduBugdu.Plugin.DataGridLive\AgduBugdu.Plugin.DataGridLive.csproj" />
    <ProjectReference Include="..\..\plugins\AgduBugdu.Plugin.TodoExplorer\AgduBugdu.Plugin.TodoExplorer.csproj" />
    <ProjectReference Include="..\..\plugins\AgduBugdu.Plugin.Debugger\AgduBugdu.Plugin.Debugger.csproj" />
    <ProjectReference Include="..\..\plugins\AgduBugdu.Plugin.Cpp\AgduBugdu.Plugin.Cpp.csproj" />
    <ProjectReference Include="..\..\plugins\AgduBugdu.Plugin.CSharp\AgduBugdu.Plugin.CSharp.csproj" />
    <ProjectReference Include="..\..\plugins\AgduBugdu.Plugin.Go\AgduBugdu.Plugin.Go.csproj" />
    <ProjectReference Include="..\..\plugins\AgduBugdu.Plugin.Java\AgduBugdu.Plugin.Java.csproj" />
    <ProjectReference Include="..\..\plugins\AgduBugdu.Plugin.Python\AgduBugdu.Plugin.Python.csproj" />
    <ProjectReference Include="..\..\plugins\AgduBugdu.Plugin.Rust\AgduBugdu.Plugin.Rust.csproj" />
  </ItemGroup>

</Project>
